local function removeTycoonButtons()

	if not Enabled then
		return
	end

	Status.Text = "Status: Removing unwanted pads..."

	local currentTycoon = getTycoon()

	if not currentTycoon then
		return
	end

	local buttons = currentTycoon:WaitForChild("Buttons")

	local buttonsToRemove = {
		"Buy 2x Cash",
		"Buy 3x Cash",
		"Buy Mercenary Pack",
		"Buy VIPDropper1",
		"Buy VIPUpgrader1",
		"Buy VIPDropper2",
		"Buy VIPUpgrader2"
	}

	for _, buttonName in ipairs(buttonsToRemove) do

		if not Enabled then
			return
		end

		local button = buttons:FindFirstChild(buttonName)

		if button then

			print("Removing:", buttonName)

			button:Destroy()

		end

	end

	task.wait(0.2)
end

--==================================================
-- CHECK IF BUTTON IS DROPPER / UPGRADER
--==================================================

local function isPriorityButton(touchPart)

	if not touchPart then
		return false
	end

	-- Check the part itself
	local name = string.lower(touchPart.Name)

	if string.find(name, "dropper", 1, true)
		or string.find(name, "upgrader", 1, true) then

		return true
	end

	-- Check all parents above the touch part
	local current = touchPart.Parent

	while current and current ~= workspace do

		local currentName = string.lower(current.Name)

		if string.find(currentName, "dropper", 1, true)
			or string.find(currentName, "upgrader", 1, true) then

			return true
		end

		current = current.Parent
	end

	return false
end

--==================================================
-- GET BUTTONS SORTED BY PRIORITY
--==================================================

local function getSortedButtons(buttons)

	local priorityButtons = {}
	local normalButtons = {}

	for _, object in ipairs(buttons:GetDescendants()) do

		if object:IsA("TouchTransmitter") then

			local touchPart = object.Parent

			if touchPart
				and touchPart:IsA("BasePart") then

				local data = {
					part = touchPart,
					priority = isPriorityButton(touchPart)
				}

				if data.priority then
					table.insert(priorityButtons, data)
				else
					table.insert(normalButtons, data)
				end

			end

		end

	end

	-- Dropper / Upgrader buttons FIRST
	for _, data in ipairs(normalButtons) do
		table.insert(priorityButtons, data)
	end

	return priorityButtons
end

--==================================================
-- BUY ALL BUTTONS
--==================================================

local function buyAllButtons()

	if not Enabled then
		return
	end

    local Event = game:GetService("ReplicatedStorage").TycoonEvent
        Event:FireServer(
            "Rebirth"
        )

	Status.Text = "Status: Buying buttons..."

	local currentTycoon = getTycoon()

	if not currentTycoon then
		return
	end

	local buttons = currentTycoon:WaitForChild("Buttons")

	local purchased = {}

	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")

	local noNewButtons = 0

	while Enabled and noNewButtons < 3 do

		local foundNewButton = false

		buttons = currentTycoon:WaitForChild("Buttons")

		-- Get buttons with Dropper / Upgrader priority
		local sortedButtons = getSortedButtons(buttons)

		for _, data in ipairs(sortedButtons) do

			if not Enabled then
				return
			end

			local touchPart = data.part

			if touchPart
				and touchPart.Parent
				and not purchased[touchPart] then

				purchased[touchPart] = true
				foundNewButton = true

				if data.priority then
					print("PRIORITY BUY:", touchPart:GetFullName())
				else
					print("Buying:", touchPart:GetFullName())
				end

				-- Refresh character/root
				character = player.Character or player.CharacterAdded:Wait()
				root = character:WaitForChild("HumanoidRootPart")

				firetouchinterest(
					touchPart,
					root,
					0
				)

				task.wait(0.1)

				firetouchinterest(
					touchPart,
					root,
					1
				)

				task.wait(0.3)

			end

		end

		if foundNewButton then

			noNewButtons = 0

		else

			noNewButtons += 1

			print(
				"No new buttons found:",
				noNewButtons,
				"/ 3"
			)

			task.wait(0.5)

		end

	end

	print("Finished buying buttons")
end

