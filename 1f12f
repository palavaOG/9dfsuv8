-- TELEPORT OTHER PLAYERS LOCALLY
--==================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local othersSpot = CFrame.new(-26.8, 3.0, -606.3)
local localSpot = CFrame.new(0, 10, 0) -- CHANGE THIS

local originalCFrame = nil
local wasEnabled = false

-- Teleport everyone EXCEPT yourself
local function tpOthers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            player.Character:PivotTo(othersSpot)
        end
    end
end

task.spawn(function()
    while true do
        if PrintEnabled then

            -- Save your original position when toggle is first enabled
            if not wasEnabled then
                if LocalPlayer.Character then
                    originalCFrame = LocalPlayer.Character:GetPivot()
                end

                wasEnabled = true
            end

            -- Teleport yourself
            if LocalPlayer.Character then
                LocalPlayer.Character:PivotTo(plrSpot)
            end

            -- Teleport everyone else
            tpOthers()

        elseif wasEnabled then

            -- Restore your original position when disabled
            if LocalPlayer.Character and originalCFrame then
                LocalPlayer.Character:PivotTo(originalCFrame)
            end

            originalCFrame = nil
            wasEnabled = false
        end

        task.wait(0.05)
    end
end)

